{
	"expo": {
		"name": "Pact",
		"slug": "pact",
		"version": "1.0.0",
		"runtimeVersion": {
			"policy": "fingerprint"
		},
		"updates": {
			"url": "https://u.expo.dev/62e729af-e435-45b2-9c49-50f2361ad44f",
			"checkAutomatically": "ON_LOAD",
			"fallbackToCacheTimeout": 0,
			"requestHeaders": {
				"expo-channel-name": "production"
			}
		},
		"orientation": "portrait",
		"scheme": "pact",
		"icon": "./assets/icon.png",
		"userInterfaceStyle": "automatic",
		"splash": {
			"image": "./assets/splash-icon.png",
			"resizeMode": "contain",
			"backgroundColor": "#0b0b0a"
		},
		"ios": {
			"supportsTablet": false,
			"bundleIdentifier": "com.gligorcogligorov.pact",
			"usesAppleSignIn": true,
			"privacyManifests": {
				"NSPrivacyAccessedAPITypes": [
					{
						"NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
						"NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
					},
					{
						"NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
						"NSPrivacyAccessedAPITypeReasons": ["C617.1", "0A2A.1", "3B52.1"]
					},
					{
						"NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
						"NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
					},
					{
						"NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
						"NSPrivacyAccessedAPITypeReasons": ["E174.1", "85F4.1"]
					}
				]
			}
		},
		"android": {
			"package": "com.gligorcogligorov.pact",
			"adaptiveIcon": {
				"foregroundImage": "./assets/icon.png",
				"backgroundColor": "#0b0b0a"
			},
			"permissions": [],
			"blockedPermissions": [
				"android.permission.READ_EXTERNAL_STORAGE",
				"android.permission.WRITE_EXTERNAL_STORAGE",
				"android.permission.RECORD_AUDIO"
			],
			"androidStatusBar": {
				"barStyle": "light-content",
				"backgroundColor": "#0b0b0a",
				"translucent": true
			},
			"predictiveBackGestureEnabled": false,
			"intentFilters": [
				{
					"action": "VIEW",
					"autoVerify": true,
					"data": [
						{
							"scheme": "pact"
						}
					],
					"category": ["BROWSABLE", "DEFAULT"]
				}
			]
		},
		"web": {
			"favicon": "./assets/icon.png"
		},
		"plugins": [
			"expo-router",
			"expo-image",
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#0b0b0a",
					"image": "./assets/splash-icon.png",
					"imageWidth": 200
				}
			],
			"expo-secure-store",
			"expo-apple-authentication",
			[
				"expo-image-picker",
				{
					"photosPermission": "$(PRODUCT_NAME) opens your photo library only when you choose a photo yourself, like a new profile picture. Only the photos you pick are shared with the app.",
					"cameraPermission": "$(PRODUCT_NAME) uses your camera to take the photo that proves today’s check-in, for example your running shoes after a run. Your pact sees the photo.",
					"microphonePermission": false
				}
			],
			["expo-notifications", {}],
			"expo-localization",
			"expo-font",
			[
				"@sentry/react-native/expo",
				{
					"url": "https://sentry.io/",
					"project": "react-native",
					"organization": "your-org"
				}
			],
			"@sentry/react-native",
			"expo-web-browser"
		],
		"extra": {
			"router": {},
			"eas": {
				"projectId": "62e729af-e435-45b2-9c49-50f2361ad44f"
			}
		},
		"owner": "gligorcos-team"
	}
}
