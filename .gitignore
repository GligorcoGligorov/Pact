# Dependencies
node_modules/
.pnp
.pnp.js

# Build output
dist/
build/
out/
.next/
.expo/
.expo-shared/
.turbo/
*.tsbuildinfo

# Native build artifacts
apps/mobile/ios/
apps/mobile/android/
# The AI judge's eval photos (apps/web/src/server/ai/judge.eval.mts): local only, never committed.
apps/web/eval-photos/
apps/web/demo-photos/
ios/Pods/
ios/build/
android/.gradle/
android/build/
android/app/build/
android/app/release/
android/.idea/
android/local.properties
*.keystore
!debug.keystore

# Mobile signing / provisioning (NEVER commit)
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Env files (NEVER commit — see *.example files instead). The same names
# .claude/settings.json denies reading; .env.example is the committed template.
.env
.env.local
.env.*.local
.env.dev
.env.development
.env.test
.env.staging
.env.preview
.env.prod
.env.production
# Catch any other variant (.env.backup, .env.vercel, ...); the template stays tracked.
.env*
!.env.example

# Credentials that must never be committed
*.pem
google-services.json
GoogleService-Info.plist
*service-account*.json

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp
*.swo

# Vercel
.vercel

# Supabase local dev — matched at any depth, so a nested supabase/ project
# (apps/*/supabase) can't leak its CLI state either.
**/supabase/.branches/
**/supabase/.temp/

# Test coverage
coverage/

# Misc
*.tgz

# Agent worktrees: Claude Code checks each one out inside this repo, and
# `git add -A` would otherwise commit them as embedded repositories.
.claude/worktrees/

# Claude Code's personal settings: each engineer's own permission approvals.
# The shared ones are .claude/settings.json, which is committed.
.claude/settings.local.json

# Claude Code session transcripts (kept out of this public copy)
.claude-logs/
